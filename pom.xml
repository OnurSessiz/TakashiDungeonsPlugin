<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.takashi</groupId>
    <artifactId>TakashiDungeons</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>TakashiDungeons</name>
    <description>Prosedürel dungeon sistemi — Paper/Spigot</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Hedef sürüm: MC 1.21.8 / api-version 1.21 / Java 21 -->
        <paper.version>1.21.8-R0.1-SNAPSHOT</paper.version>
        <sqlite.version>3.53.2.1</sqlite.version>
        <!-- Derleme tabani bilerek 7.3 hattinda: FAWE 2.15 (7.4 tabanli) ve duz WorldEdit 7.3
             ikisinde de calisan API yuzeyine karsi derliyoruz. Yeniye karsi derleyip eskide
             calistirmak NoSuchMethodError uretir, tersi guvenli. -->
        <worldedit.version>7.3.16</worldedit.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- WorldEdit/FAWE API -->
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Sunucu tarafından sağlanır, jar'a girmez -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- WorldEdit API. FAWE de aynı paket adlarını (com.sk89q.worldedit.*) sağlar,
             bu yüzden tek kod yolu ikisiyle de çalışır. Sunucudan gelir, jar'a girmez. -->
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-bukkit</artifactId>
            <version>${worldedit.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- FAZ 7'de kullanılacak; shade + relocate altyapısı şimdiden doğrulansın diye burada -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <resources>
            <!-- filtering: plugin.yml içindeki ${project.version} otomatik dolsun -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- native kaynaklar budanmasın -->
                            <minimizeJar>false</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!--
                                SQLite driver'i RELOCATE EDILMIYOR - denendi ve kirdi (FAZ 7).
                                Relocation Java siniflarini tasiyor ama .dll/.so icindeki JNI
                                sembolleri "Java_org_sqlite_core_NativeDB__1open_1utf8" adini
                                tasimaya devam ediyor; tasinmis sinif artik olmayan bir sembol
                                ariyor ve ilk baglantida UnsatisfiedLinkError dusuyor. Native
                                kod iceren hicbir kutuphane relocate edilemez.

                                Cakisma riski yok: her Bukkit plugin'i kendi classloader'inda
                                yasiyor ve sqlite-jdbc native'i her classloader icin ayri, UUID
                                ekli bir gecici dosyaya aciyor - tam olarak bu senaryo icin.
                                Paper 1.21.8 zaten kendi sqlite-jdbc'sini tasiyor; parent-first
                                delegasyon yuzunden orada onunki kullaniliyor, buradaki kopya
                                Spigot'ta ve Paper onu birakirsa devreye giren sigorta.
                            -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <!--
                                        sqlite-jdbc her platformun native'ini tasiyor ve tek
                                        basina jar'i 12 MB yapiyor. Bir Minecraft sunucusunun
                                        kostugu mimariler birakiliyor (x86_64 ve aarch64:
                                        Windows, Linux, Linux-Musl/Alpine, Mac); gerisi
                                        indirilen jar'i sisirmekten baska is yapmiyor.

                                        Sadece EXCLUDE yaziliyor, include ile karistirilmiyor:
                                        shade'de exclude include'u yener, yani "hepsini at,
                                        sunlari geri al" diye bir sey yazilamaz.
                                    -->
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/armv7/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
